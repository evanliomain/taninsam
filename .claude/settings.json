{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-state.sh\" baseline",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-state.sh\" gate",
            "timeout": 15,
            "statusMessage": "Checking whether this session still needs its review"
          }
        ]
      }
    ]
  }
}
